# i3 config (v4) — Catppuccin Mocha rice
# Reference: https://i3wm.org/docs/userguide.html

set $mod Mod4
set $term alacritty
set $rofi_dir ~/.config/rofi

# ---------- Catppuccin Mocha palette ----------
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

# class                 border    bground  text      indicator  child_border
client.focused          $mauve    $base    $text     $rosewater $mauve
client.focused_inactive $surface1 $base    $subtext0 $surface1  $surface1
client.unfocused        $surface0 $mantle  $overlay1 $surface0  $surface0
client.urgent           $red      $base    $red      $red       $red
client.placeholder      $overlay0 $base    $text     $overlay0  $overlay0
client.background       $base

# ---------- Look ----------
font pango:JetBrainsMono Nerd Font 10

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none
for_window [class=".*"] border pixel 2

gaps inner 8
gaps outer 2

focus_follows_mouse no

# ---------- Autostart ----------
exec --no-startup-id VBoxClient-all
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id dunst
exec --no-startup-id nm-applet
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork -c 1e1e2e
exec_always --no-startup-id feh --no-fehbg --bg-fill ~/Pictures/wallpapers/catppuccin-mocha.png
exec_always --no-startup-id ~/.config/polybar/launch.sh

# ---------- Audio / media keys ----------
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPlay        exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext        exec --no-startup-id playerctl next
bindsym XF86AudioPrev        exec --no-startup-id playerctl previous

# ---------- Apps / launchers ----------
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+Shift+f exec --no-startup-id thunar
bindsym $mod+d       exec --no-startup-id rofi -show drun
bindsym $mod+Shift+d exec --no-startup-id rofi -show run
bindsym $mod+Tab     exec --no-startup-id rofi -show window
bindsym $mod+Shift+e exec --no-startup-id $rofi_dir/powermenu.sh
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 1e1e2e

# Screenshots: Print = full screen, Shift+Print = select area, $mod+Print = active window
# (saved to ~/Pictures/screenshots and copied to the clipboard)
bindsym Print       exec --no-startup-id sh -c 'f=~/Pictures/screenshots/$(date +%F_%H-%M-%S).png; maim "$f" && xclip -selection clipboard -t image/png < "$f" && notify-send -i "$f" "Screenshot" "Saved and copied"'
bindsym Shift+Print exec --no-startup-id sh -c 'f=~/Pictures/screenshots/$(date +%F_%H-%M-%S).png; maim -s "$f" && xclip -selection clipboard -t image/png < "$f" && notify-send -i "$f" "Screenshot" "Area saved and copied"'
bindsym $mod+Print  exec --no-startup-id sh -c 'f=~/Pictures/screenshots/$(date +%F_%H-%M-%S).png; maim -i $(xdotool getactivewindow) "$f" && xclip -selection clipboard -t image/png < "$f" && notify-send -i "$f" "Screenshot" "Window saved and copied"'

# Notifications
bindsym $mod+n       exec --no-startup-id dunstctl close-all
bindsym $mod+grave   exec --no-startup-id dunstctl history-pop

# ---------- Window management ----------
floating_modifier $mod
tiling_drag modifier titlebar

bindsym $mod+Shift+q kill

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# splits / layouts
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# toggle gaps on the current workspace
bindsym $mod+g       gaps inner current toggle 8
bindsym $mod+Shift+g gaps outer current toggle 2

# floating rules
for_window [class="Pavucontrol"]          floating enable, resize set 800 500, move position center
for_window [class="Lxappearance"]         floating enable
for_window [class="qt5ct"]                floating enable
for_window [class="kvantummanager"]       floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="Thunar" title="^File Operation Progress"] floating enable
for_window [class="Thunar" title="^Rename"]                  floating enable
for_window [class="Thunar" title="Properties$"]              floating enable
for_window [class="Xarchiver"]            floating enable, resize set 800 500, move position center
for_window [window_role="pop-up"]         floating enable
for_window [window_role="dialog"]         floating enable
for_window [window_type="dialog"]         floating enable

# ---------- Workspaces ----------
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# ---------- Resize mode ----------
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# No i3bar — polybar is launched above.
